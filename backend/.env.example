# ===== ImageKit Configuration =====
# Get these from ImageKit Dashboard: https://imagekit.io/dashboard/developer/api-keys

# Public key for ImageKit authentication
IMAGEKIT_PUBLIC_KEY=your_public_key_here

# Private key for server-side operations (KEEP SECURE - never expose in frontend)
IMAGEKIT_PRIVATE_KEY=your_private_key_here

# URL endpoint for your ImageKit account
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_endpoint/

# ===== Email (Brevo transactional API) =====
# From SMTP & API → API keys & MCP in the Brevo dashboard. Deliberately the
# HTTP API, not the SMTP relay — SMTP auth there is gated by an IP allowlist
# that a rotating/dev-machine public IP can't reliably satisfy.
BREVO_API_KEY=your_brevo_api_key_here
# Must be a sender verified in Brevo (Senders, Domains & Dedicated IPs →
# Senders) — a personal Gmail works for now if nothing's pre-verified.
MAIL_FROM=HomeCare <your_verified_sender@example.com>

# Base URL of the customer-facing frontend (for dashboard/estimate links)
CUSTOMER_APP_URL=http://localhost:3000
